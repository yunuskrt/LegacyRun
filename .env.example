# Neon PostgreSQL connection string — the only database used by LegacyRun.
# Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/legacyrun?sslmode=require"

# Historical data ingestion (Phases 5-8). Ingestion-time only — never used at runtime.
# Identify your scraper honestly, including a contact address.
SCRAPER_USER_AGENT="LegacyRun/0.1 (+contact@example.com)"

# Minimum delay between scraper requests, in milliseconds. Keep this polite.
SCRAPER_RATE_LIMIT_MS="3000"
