generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Position {
  PG
  SG
  SF
  PF
  C
}

enum Conference {
  EAST
  WEST
}

enum PlayoffRound {
  FIRST_ROUND
  CONFERENCE_SEMIS
  CONFERENCE_FINALS
  NBA_FINALS
  CHAMPION
}

model Player {
  slug      String   @id
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")

  playerSeasons PlayerSeason[]

  @@map("players")
}

model Team {
  slug       String     @id
  name       String
  conference Conference
  createdAt  DateTime   @default(now()) @map("created_at")

  teamSeasons          TeamSeason[]
  playoffParticipation PlayoffParticipation[]

  @@map("teams")
}

model TeamSeason {
  id         String   @id
  teamSlug   String   @map("team_slug")
  seasonYear Int      @map("season_year")
  rating     Float
  createdAt  DateTime @default(now()) @map("created_at")

  team          Team               @relation(fields: [teamSlug], references: [slug], onDelete: Cascade)
  playerSeasons PlayerSeasonTeam[]

  @@unique([teamSlug, seasonYear])
  @@index([seasonYear])
  @@index([rating])
  @@map("team_seasons")
}

model PlayerSeason {
  id         String   @id
  playerSlug String   @map("player_slug")
  seasonYear Int      @map("season_year")
  age        Int
  position   Position
  rating     Float
  createdAt  DateTime @default(now()) @map("created_at")

  player Player             @relation(fields: [playerSlug], references: [slug], onDelete: Cascade)
  teams  PlayerSeasonTeam[]
  data   PlayerSeasonData?

  @@unique([playerSlug, seasonYear])
  @@index([seasonYear])
  @@map("player_seasons")
}

model PlayerSeasonTeam {
  id             String   @id @default(cuid())
  playerSeasonId String   @map("player_season_id")
  teamSeasonId   String   @map("team_season_id")
  createdAt      DateTime @default(now()) @map("created_at")

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id], onDelete: Cascade)
  teamSeason   TeamSeason   @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade)

  @@unique([playerSeasonId, teamSeasonId])
  @@index([teamSeasonId])
  @@map("player_season_teams")
}

model PlayerSeasonData {
  playerSeasonId         String   @id @map("player_season_id")
  rank                   Int
  gamesPlayed            Int      @map("games_played")
  minutesPlayed          Int      @map("minutes_played")
  playerEfficiencyRating Float?   @map("player_efficiency_rating")
  boxPlusMinus           Float?   @map("box_plus_minus")
  vorp                   Float?
  winSharesPer48         Float?   @map("win_shares_per_48")
  createdAt              DateTime @default(now()) @map("created_at")

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id], onDelete: Cascade)

  @@map("player_season_data")
}

// `id` is deterministic — `{teamSlug}-{seasonYear}` — and has no default, so
// every create must supply it rather than falling back to a random cuid.
model PlayoffParticipation {
  id           String       @id
  teamSlug     String       @map("team_slug")
  seasonYear   Int          @map("season_year")
  conference   Conference
  seed         Int
  roundReached PlayoffRound @map("round_reached")
  wins         Int
  losses       Int
  createdAt    DateTime     @default(now()) @map("created_at")

  team Team @relation(fields: [teamSlug], references: [slug], onDelete: Cascade)

  @@unique([teamSlug, seasonYear])
  @@index([seasonYear])
  @@index([conference, seasonYear])
  @@map("playoff_participation")
}
